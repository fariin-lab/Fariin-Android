<?xml version="1.0" encoding="utf-8"?>
<!-- App icon (Settings > Appearance > App Icon): the iOS art (icon-plus-graphite-line) filling the visible part of
     the icon over its own corner colour; the foreground is empty. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/app_icon_ground_plus_graphite_line" />
    <foreground android:drawable="@android:color/transparent" />
</adaptive-icon>
