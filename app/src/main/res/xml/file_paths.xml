<?xml version="1.0" encoding="utf-8"?>
<!-- Only the opened copies of received documents are shared (media/FileOpener). -->
<paths>
    <cache-path name="open" path="open/" />
    <!-- Items shared INTO Fariin, copied before sending (system/ShareActivity). -->
    <cache-path name="shared" path="shared-in/" />
    <!-- Story camera photos and clips, read back through the same path as a picked item (ui/stories/StoryCamera). -->
    <cache-path name="camera" path="story-camera/" />
    <!-- A photo drawn on in the chat photo editor, sent or put back in the attach sheet (ui/thread/PhotoDrawEditor). -->
    <cache-path name="edited" path="edited/" />
</paths>
