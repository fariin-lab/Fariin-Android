<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Voice notes: asked on the first hold of the mic, never at start. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Save to gallery: MediaStore needs no permission on 10+; Android 9 (minSdk 28) still needs this one (media worker). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- Calls (call/, ui/call/): camera for video, audio routing, the ongoing-call service, the
         ring over the lock screen. Camera and mic are asked when a call needs them. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- The proximity sensor turns the screen off at the ear during a voice call. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <application
        android:name=".FariinApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Fariin">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Fariin.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Call links (call/CallLinks.kt). App Links: https://call.fariin.com/video/<id> and
                 /voice/<id>, the same paths on fariin.com, and the old fariin.com/call/#key=...
                 Verified only once https://call.fariin.com and https://fariin.com serve
                 /.well-known/assetlinks.json naming com.fariin.app (see PROGRESS.md). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="call.fariin.com" />
                <data android:host="fariin.com" />
                <data android:host="www.fariin.com" />
                <data android:pathPrefix="/video/" />
                <data android:pathPrefix="/voice/" />
                <data android:path="/call" />
                <data android:path="/call/" />
            </intent-filter>
            <!-- The web landing page's "Open" button: kulan://video/<id>, kulan://voice/<id>, kulan://call/<key>. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kulan" />
                <data android:host="video" />
                <data android:host="voice" />
                <data android:host="call" />
            </intent-filter>
        </activity>
        <!-- App Lock cover (security/AppLock.kt). -->
        <activity
            android:name=".security.LockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Fariin" />
        <activity
            android:name=".ui.call.CallActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:taskAffinity="com.fariin.app.call"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:theme="@style/Theme.Fariin" />
        <service
            android:name=".call.CallService"
            android:exported="false"
            android:foregroundServiceType="phoneCall|microphone|camera" />
        <!-- Fariin calls as system calls (call/CallTelecom.kt): headset, car and Bluetooth buttons,
             audio routes, hold and busy. Only Telecom may bind it. -->
        <service
            android:name=".call.FariinConnectionService"
            android:exported="true"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>
        <!-- Push: Fariin draws every chat notification itself (push/FariinMessagingService). A push
             with a notification block that arrives while the app is closed is drawn by Android,
             in the Messages channel with this icon. -->
        <service
            android:name=".push.FariinMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="messages" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_chat" />
        <!-- Received documents open in another app from cache/open (media worker). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
